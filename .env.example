# Database - PostgreSQL
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
# Banco de desenvolvimento. Não commite o .env e não coloque credencial real aqui.
# Testes de integração exigem POSTGRES_DB=nexus_ai_test e as migrations aplicadas
# nesse banco: POSTGRES_DB=nexus_ai_test python -m alembic upgrade head
POSTGRES_DB=nexus_ai

# Backend running locally
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Cache / jobs
REDIS_URL=

# Auth
# Obrigatório. Gere um segredo forte (mínimo 32 bytes) e coloque só no seu .env local:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixe vazio aqui: a aplicação não inicia sem um segredo válido.
JWT_SECRET_KEY=
# Opcional (padrão 30 minutos). Algoritmo (HS256), issuer e audience são fixos no código.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# App
# ENVIRONMENT: development (padrão), test ou production.
# DEBUG: padrão False. Em produção DEBUG deve ser False: com ENVIRONMENT=production
# e DEBUG=true a aplicação não inicia (debug expõe traceback nas respostas 500).
ENVIRONMENT=development
DEBUG=false
APP_HOST=
APP_PORT=
LOG_LEVEL=
