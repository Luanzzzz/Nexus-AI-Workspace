# Database - PostgreSQL
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
# Banco de desenvolvimento. Não commite o .env e não coloque credencial real aqui.
# Testes de integração exigem POSTGRES_DB=nexus_ai_test e as migrations aplicadas
# nesse banco: POSTGRES_DB=nexus_ai_test python -m alembic upgrade head
POSTGRES_DB=nexus_ai

# Backend running locally
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Cache / jobs
REDIS_URL=

# Auth
# Obrigatório. Gere um segredo forte (mínimo 32 bytes, sem placeholder e
# sem baixa entropia) e coloque só no seu .env local:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixe vazio aqui: a aplicação não inicia sem um segredo válido.
JWT_SECRET_KEY=
# IPs (vírgula) autorizados a definir X-Forwarded-For. Padrão vazio.
# TRUSTED_PROXIES=
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_LOGIN_PER_EMAIL_LIMIT=5
# AUTH_LOGIN_PER_IP_LIMIT=20
# AUTH_REGISTER_PER_IP_LIMIT=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_PRE_PING=true
# Opcional (padrão 30 minutos). Algoritmo (HS256), issuer e audience são fixos no código.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# App
# ENVIRONMENT: development (padrão), test ou production.
# DEBUG: padrão False. Só altera o FastAPI em development.
# ENVIRONMENT=production com DEBUG=true impede a inicialização.
# Em production as docs OpenAPI (/docs, /redoc, /openapi.json) ficam desligadas.
ENVIRONMENT=development
DEBUG=false
APP_HOST=
APP_PORT=
LOG_LEVEL=

# Diretório do storage de documentos (padrao: backend/var/documents). Use um caminho fora de pastas públicas.
# DOCUMENT_STORAGE_DIR=/caminho/para/documentos
